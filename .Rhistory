# sample_name <- 'QY_2213'
# ==============================================================================
# Read data
# ==============================================================================
data_dir <- '/Users/emiliac/Dropbox/Rotations/Zhang_lab/scATAC/OtherData/C57BL6J_liver_hippocampus/'
ref_dir <- '/Users/emiliac/Dropbox/Rotations/Zhang_lab/scATAC/Files/'
out_dir <- '/Users/emiliac/Dropbox/Rotations/Zhang_lab/scATAC/output_OtherData/C57BL6J_liver_hippocampus/'
fig_dir <- '/Users/emiliac/Dropbox/Rotations/Zhang_lab/scATAC/Figures/V1/Figure3/'
samples <- c('MM_1202', 'MM_1203', 'MM_1220', 'MM_1221', 'QY_2213',
'QY_2215', 'QY_2217', 'QY_2219', 'QY_2241', 'QY_2243',
'QY_2245', 'QY_2247', 'QY_2320', 'QY_2322', 'QY_2324',
'QY_2326')
metadat.all <- readRDS(paste0(data_dir, 'liver_metadata.RDS'))
etrp <- read.csv(paste0(data_dir, 'liver_data_hepatocyte_only_cellular_dispersion_SAVER.csv'))
cn.alt.all.CHASM <- readRDS(paste0(out_dir, 'Summary/cn_bin_eval_alter_all_050626.rds'))
cn.alt.all.epi <- data.frame()
for(sample_name in samples){
print(sample_name)
df <- readRDS(paste0(out_dir, 'epiAneufinder/Summary/', sample_name, '_pct_alter.rds'))
cn.alt.all.epi <- rbind(cn.alt.all.epi, df)
}
cn.alt.all.epi$cell_id <- paste0(cn.alt.all.epi$library_id, '|', cn.alt.all.epi$cell_id)
cn.alt.all.copyscat <- data.frame()
# samples.scat <- samples[samples!='MM_1203']
for(sample_name in samples.scat){
print(sample_name)
df <- readRDS(paste0(out_dir, 'out_CopyscAT_C57BL6J_liver_hippocampus/Genome_Summary/', sample_name, '_pct_alter_df.rds'))
df$library_id <- sample_name
cn.alt.all.copyscat <- rbind(cn.alt.all.copyscat, df)
}
# samples.scat <- samples[samples!='MM_1203']
for(sample_name in samples){
print(sample_name)
df <- readRDS(paste0(out_dir, 'out_CopyscAT_C57BL6J_liver_hippocampus/Genome_Summary/', sample_name, '_pct_alter_df.rds'))
df$library_id <- sample_name
cn.alt.all.copyscat <- rbind(cn.alt.all.copyscat, df)
}
cn.alt.all.copyscat$cell_id <- paste0(cn.alt.all.copyscat$library_id, '|', cn.alt.all.copyscat$ID, '-1')
# ==============================================================================
# Wrangle data
# ==============================================================================
metadat.all.cellinfo <- metadat.all %>%
filter(group %in% samples) %>%
select(group, age, annotation, nCount_RNA, nFeature_RNA)
metadat.all.cellinfo$rowname <- rownames(metadat.all.cellinfo)
metadat.all.cellinfo$cell_id <- rownames(metadat.all.cellinfo)
metadat.all.cellinfo$cell_id <- str_split_fixed(metadat.all.cellinfo$cell_id, pattern = '_', n = 2)[,1]
metadat.all.cellinfo$cell_id <- paste0(metadat.all.cellinfo$group, '|', metadat.all.cellinfo$cell_id)
cn.alt.all.epi <- merge(metadat.all.cellinfo, cn.alt.all.epi, by = 'cell_id')
cn.alt.all.copyscat <- merge(metadat.all.cellinfo, cn.alt.all.copyscat, by = 'cell_id')
cn.alt.all.CHASM$cell_id <- str_split_fixed(cn.alt.all.CHASM$ID, pattern = '_', n = 2)[,1]
cn.alt.all.CHASM$cell_id <- paste0(cn.alt.all.CHASM$sample_name, '|', cn.alt.all.CHASM$cell_id)
summary.alt.CHASM <- cn.alt.all.CHASM %>%
group_by(sample_name, age, annotation) %>%
summarise(mean_pct_alter = mean(pct.alter),
median_pct_alter = median(pct.alter),
n_cells = n()) %>%
mutate(method = 'CHASM')
summary.alt.epi <- cn.alt.all.epi %>%
group_by(group, age, annotation) %>%
summarise(mean_pct_alter = mean(pct_alter),
median_pct_alter = median(pct_alter),
n_cells = n()) %>%
mutate(method = 'EpiAneufinder')
summary.alt.copyscat <- cn.alt.all.copyscat %>%
group_by(group, age, annotation) %>%
summarise(mean_pct_alter = mean(pct_alter),
median_pct_alter = median(pct_alter),
n_cells = n()) %>%
mutate(method = 'CopyscAT')
summary.alt.all <- rbind(summary.alt.CHASM %>% rename(library_id = sample_name),
summary.alt.epi %>% rename(library_id = group),
summary.alt.copyscat %>% rename(library_id = group))
View(summary.alt.CHASM)
View(summary.alt.copyscat)
View(summary.alt.copyscat)
summary.alt.all <- rbind(summary.alt.CHASM %>% rename(library_id = sample_name),
summary.alt.epi %>% rename(library_id = group),
summary.alt.copyscat %>% rename(library_id = group))
View(summary.alt.CHASM)
summary.alt.all <- rbind(summary.alt.CHASM %>% dplyr::rename(library_id = sample_name),
summary.alt.epi %>% dplyr::rename(library_id = group),
summary.alt.copyscat %>% dplyr::rename(library_id = group))
# ==============================================================================
# Compare between yound and old
# ==============================================================================
summary.alt.all$age <- factor(summary.alt.all$age, levels = c('young', 'old'))
summary.alt.all$method <- factor(summary.alt.all$method, levels = c('CHASM', 'EpiAneufinder', 'CopyscAT'))
summary.alt.Hepa <- summary.alt.all %>% filter(annotation == 'Hepatocyte')
ggplot(summary.alt.Hepa, aes(x = age, y = mean_pct_alter, fill = age)) +
geom_quasirandom( width = 0.15, shape = 21, color = 'black') +
geom_boxplot(outlier.shape = NA, width = 0.45, alpha = 0.6, linewidth = 0.3) +
stat_compare_means(aes(group = age),
comparisons = list(c("young", "old")),
label = "p.format", size = 2) +
scale_fill_manual(values = c('young' = '#9CC6DB', 'old' = '#CF4B00'), guide = 'none') +
facet_wrap(~ method, scale = 'free_y') +
expand_limits(y = 0) +
xlab('Age') +
ylab('Mean Percentage of Genome Altered (%)') +
theme_bw(base_size = 7) +
theme(panel.grid.minor = element_blank(),
panel.spacing = unit(0.7, "cm"))
?geom_quasirandom
??geom_quasirandom
library(ggbeeswarm)
ggplot(summary.alt.Hepa, aes(x = age, y = mean_pct_alter, fill = age)) +
geom_quasirandom( width = 0.15, shape = 21, color = 'black') +
geom_boxplot(outlier.shape = NA, width = 0.45, alpha = 0.6, linewidth = 0.3) +
stat_compare_means(aes(group = age),
comparisons = list(c("young", "old")),
label = "p.format", size = 2) +
scale_fill_manual(values = c('young' = '#9CC6DB', 'old' = '#CF4B00'), guide = 'none') +
facet_wrap(~ method, scale = 'free_y') +
expand_limits(y = 0) +
xlab('Age') +
ylab('Mean Percentage of Genome Altered (%)') +
theme_bw(base_size = 7) +
theme(panel.grid.minor = element_blank(),
panel.spacing = unit(0.7, "cm"))
ggsave(paste0(fig_dir, 'Mouse_liver_cn_bin_eval_alter_boxplot_ALL_050626.pdf'), width = 4, height = 1.5)
# ==============================================================================
# Compare with transcriptional entropy
# ==============================================================================
metadat.all.cellinfo <- merge(metadat.all.cellinfo, etrp, by.x = 'rowname', by.y = 'Cell_barcode')
metadat.all.cellinfo <- metadat.all.cellinfo %>%
filter(nFeature_RNA > 500)
etrp.cn.alt.CHASM <- merge(cn.alt.all.CHASM, metadat.all.cellinfo[, c('cell_id', 'Cell_level_deviation')], by = 'cell_id')
etrp.cn.alt.epi <- merge(cn.alt.all.epi, metadat.all.cellinfo[, c('cell_id', 'Cell_level_deviation')], by = 'cell_id')
etrp.cn.alt.copyscat <- merge(cn.alt.all.copyscat, metadat.all.cellinfo[, c('cell_id', 'Cell_level_deviation')], by = 'cell_id')
# calculate correlation for each sample
cor_results.CHASM <- etrp.cn.alt.CHASM %>%
filter(Cell_level_deviation < 1000) %>%
filter(pct.alter > 0) %>%
group_by(sample_name, age) %>%
summarise(cor = cor(pct.alter, log10(Cell_level_deviation), method = 'spearman'),
p_value = cor.test(pct.alter, log10(Cell_level_deviation), method = 'spearman')$p.value)
cor_results.epi <- etrp.cn.alt.epi %>%
filter(Cell_level_deviation < 1000) %>%
filter(pct_alter > 0) %>%
group_by(group, age) %>%
summarise(cor = cor(pct_alter, log10(Cell_level_deviation), method = 'spearman'),
p_value = cor.test(pct_alter, log10(Cell_level_deviation), method = 'spearman')$p.value)
cor_results.copyscat <- etrp.cn.alt.copyscat %>%
filter(Cell_level_deviation < 1000) %>%
filter(pct_alter > 0) %>%
group_by(group, age) %>%
summarise(cor = cor(pct_alter, log10(Cell_level_deviation), method = 'spearman'),
p_value = cor.test(pct_alter, log10(Cell_level_deviation), method = 'spearman')$p.value)
cor_results.CHASM$method <- 'CHASM'
cor_results.epi$method <- 'EpiAneufinder'
cor_results.copyscat$method <- 'CopyscAT'
cor_results.all <- rbind(cor_results.CHASM %>% rename(library_id = sample_name),
cor_results.epi %>% rename(library_id = group),
cor_results.copyscat %>% rename(library_id = group))
cor_results.all <- rbind(cor_results.CHASM %>% dplyr::rename(library_id = sample_name),
cor_results.epi %>% dplyr::rename(library_id = group),
cor_results.copyscat %>% dplyr::rename(library_id = group))
cor_results.all$method <- factor(cor_results.all$method, levels = c('CHASM', 'EpiAneufinder', 'CopyscAT'))
ggplot(cor_results.all, aes(x = method, y = cor)) +
geom_jitter(aes(fill = age), width = 0.15, shape = 21, color = 'black') +
geom_boxplot(outlier.shape = NA, width = 0.45, alpha = 0.6, linewidth = 0.3) +
stat_compare_means(comparisons = list(c("CHASM", "EpiAneufinder"),
c("CHASM", "CopyscAT")),
label = "p.format", size = 2,
label.y = 0.8, step.increase = 0.1) +
scale_fill_manual(values = c('young' = '#9CC6DB', 'old' = '#CF4B00')) +
expand_limits(y = c(0, 1)) +
xlab('') +
theme_bw(base_size = 7) +
ylab('Correlation Coefficient') +
theme(panel.grid.minor = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1))
ggsave(paste0(fig_dir, 'Mouse_liver_cn_bin_eval_alter_correlation_transcription_etrp_ALL_050626.pdf'), width = 2.5, height = 2)
