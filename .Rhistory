library(tidyverse)
options(scipen = 999)
res <- 0.3
brkp_cutoff <- 15
chromosomes <- c(paste0("chr", 1:22), "chrX", "chrY")
data_dir <- "/Users/emiliac/Dropbox/Rotations/Zhang_lab/scATAC/OtherData/"
output_dir <- "/Users/emiliac/Dropbox/Rotations/Zhang_lab/scATAC/output_OtherData/Lin_et_al_breast_epi_GSE272504/"
ref_dir <- "/Users/emiliac/Dropbox/Rotations/Zhang_lab/scATAC/Files/"
eval_dir <- paste0(output_dir, "Evaluate/")
dir.create(eval_dir, recursive = TRUE, showWarnings = FALSE)
bin_ref <- read.table(paste0(ref_dir, "genomic_windows_5mb.bed"), sep = "\t")
colnames(bin_ref) <- c("chr", "start", "end", "arm")
bc2srr2atac <- read.csv(
paste0(data_dir, "Lin_et_al_breast_epi_GSE272504/SraRunTable_bc2srr2ATAC_withCellType_032126.csv")
)
samples <- unique(bc2srr2atac$Patient_ID)
chromArm.df <- bin_ref %>%
group_by(chr, arm) %>%
summarise(start = min(start), end = max(end), .groups = "drop") %>%
mutate(chromArm = paste0(chr, arm)) %>%
dplyr::select(chr, start, end, chromArm)
sample_name <- samples[1]
message("Processing ", sample_name)
load(paste0(output_dir, "CopyscAT/", sample_name, "_new/final_cnv_list.RData"))
cn.ck <- readRDS(paste0(output_dir, "copykit_scDNA/", sample_name, "_copykit_out.rds"))
bc2srr2atac.sample <- bc2srr2atac %>% filter(Patient_ID == sample_name)
ck.mat <- segment_ratios(cn.ck[, SummarizedExperiment::colData(cn.ck)$breakpoint_count < brkp_cutoff])
bin.ck <- cn.ck@rowRanges %>% as.data.frame()
bin.ck <- bin.ck %>% dplyr::select(seqnames, start, end, arm)
bin.ck$bin <- paste0(bin.ck$seqnames, "_", bin.ck$start, "_", bin.ck$end, "_", bin.ck$arm)
rownames(ck.mat) <- bin.ck$bin
ck.mat <- as.data.frame(t(ck.mat))
res.copyscat <- final_cnv_list[[3]]
rownames(res.copyscat) <- res.copyscat$rowname
res.copyscat <- res.copyscat[, -1]
rownames(res.copyscat) <- gsub("\\-1", "", rownames(res.copyscat))
res.copyscat$ID <- rownames(res.copyscat)
tmp <- paste0(chromosomes, "p")
tmp2 <- paste0(chromosomes, "q")
bin.list.copyscat <- unlist(do.call(Map, c(f = c, tmp, tmp2)), use.names = FALSE)
missing_bins <- setdiff(bin.list.copyscat, colnames(res.copyscat))
for (bin in missing_bins) {
res.copyscat[[bin]] <- 2
}
res.copyscat <- res.copyscat[, c("ID", bin.list.copyscat), drop = FALSE] %>%
pivot_longer(cols = -ID, names_to = "chromArm", values_to = "CN_state") %>%
mutate(CN_state_int = round(CN_state, 0))
chromArm.df.GR <- GenomicRanges::makeGRangesFromDataFrame(
chromArm.df,
seqnames.field = "chr",
start.field = "start",
end.field = "end",
keep.extra.columns = TRUE
)
bin.ck.GR <- GenomicRanges::makeGRangesFromDataFrame(
bin.ck,
seqnames.field = "seqnames",
start.field = "start",
end.field = "end",
keep.extra.columns = TRUE
)
overlaps.chromArm.ck <- GenomicRanges::findOverlaps(chromArm.df.GR, bin.ck.GR)
chromArm_ck_map <- tibble(
chromArm = chromArm.df$chromArm[S4Vectors::queryHits(overlaps.chromArm.ck)],
bin.ck = bin.ck$bin[S4Vectors::subjectHits(overlaps.chromArm.ck)]
)
View(chromArm_ck_map)
res.copyscat.expand <- res.copyscat %>%
filter(ID %in% bc2srr2atac.sample$barcode) %>%
inner_join(chromArm_ck_map, by = "chromArm") %>%
group_by(ID, bin.ck) %>%
summarise(CN_state = mean(CN_state_int), .groups = "drop") %>%
distinct() %>%
pivot_wider(names_from = bin.ck, values_from = CN_state)
res.copyscat.expand <- as.data.frame(res.copyscat.expand)
if (nrow(res.copyscat.expand) == 0) {
message("Skipping ", sample_name, ": no CopyscAT cells mapped to CopyKit bins")
next
}
rownames(res.copyscat.expand) <- res.copyscat.expand$ID
res.copyscat.expand$ID <- NULL
cells.DNA.ct <- bc2srr2atac.sample %>%
filter(in_scDNA == TRUE & barcode %in% rownames(res.copyscat.expand))
if (nrow(cells.DNA.ct) == 0) {
message("Skipping ", sample_name, ": no cells shared between scDNA and CopyscAT")
next
}
common.bins <- intersect(bin.ck$bin, colnames(res.copyscat.expand))
if (length(common.bins) == 0) {
message("Skipping ", sample_name, ": no overlapping bins between CopyKit and CopyscAT")
next
}
res.copyscat.expand <- res.copyscat.expand[, common.bins, drop = FALSE]
comp.res <- lapply(seq_len(nrow(cells.DNA.ct)), function(x) {
cell.DNA <- cells.DNA.ct$ID_scDNA[x]
cell.ATAC <- cells.DNA.ct$barcode[x]
if (!cell.DNA %in% rownames(ck.mat) || !cell.ATAC %in% rownames(res.copyscat.expand)) {
return(NULL)
}
cn.ct <- res.copyscat.expand[cell.ATAC, common.bins, drop = FALSE]
cn.ct <- ifelse(cn.ct == 2, 1, ifelse(cn.ct > 2, 2, ifelse(cn.ct < 2, 0, NA)))
cn.cell <- ck.mat[cell.DNA, common.bins, drop = FALSE]
cn.cell <- ifelse(cn.cell > 1 + res, 2, ifelse(cn.cell < 1 - res, 0, 1))
cn.cell.vec <- unlist(cn.cell[1, common.bins], use.names = TRUE)
cn.ct.vec <- unlist(cn.ct[1, common.bins], use.names = TRUE)
distance <- sqrt(sum((cn.cell.vec - cn.ct.vec)^2, na.rm = TRUE))
mse <- mean((cn.cell.vec - cn.ct.vec)^2, na.rm = TRUE)
abs_diff <- sum(abs(cn.cell.vec - cn.ct.vec), na.rm = TRUE)
data.frame(
cell.DNA = cell.DNA,
cell.ATAC = cell.ATAC,
distance = distance,
mse = mse,
abs_diff = abs_diff,
n_bins = length(common.bins),
avg_length_bin = mean(bin.ck$end - bin.ck$start + 1)
)
})
comp.res.df <- bind_rows(comp.res)
View(comp.res.df)
hist(comp.res.df$abs_diff)
??segment_ratios
library(copykit)
rm(list = ls())
library(tidyverse)
options(scipen = 999)
chromosomes <- c(paste0('chr', 1:22), 'chrX', 'chrY')
# ==============================================================================
# Read data
# ==============================================================================
data_dir <- '/Users/emiliac/Dropbox/Rotations/Zhang_lab/scATAC/OtherData/Lin_et_al_breast_epi_GSE272504/'
output_dir <- '/Users/emiliac/Dropbox/Rotations/Zhang_lab/scATAC/output_OtherData/Lin_et_al_breast_epi_GSE272504/'
metadata <- read.csv(paste0(data_dir, 'ArchR_metadata.csv'), row.names = 1)
metadata$celltype <- ifelse(metadata$Harmony_Seurat_clusters == 'C5', 'Basal',
ifelse(metadata$Harmony_Seurat_clusters %in% c('C6', 'C7'), 'LumHR',
ifelse(metadata$Harmony_Seurat_clusters %in% c('C1', 'C2', 'C3', 'C4'), 'LumSec', 'Other')))
bc2srr2atac <- read.csv(paste0(data_dir, 'SraRunTable_bc2srr2ATAC.csv'))
samples <- unique(metadata$Sample)
samples <- samples[!samples %in% c('GSM8403673_P08')]
bc2srr2atac.overall <- data.frame()
brkp_cutoff <- 15
for(sample_name in samples){
# format IDs
patient_id <- strsplit(sample_name, '_')[[1]][2]
print(paste0('Processing sample: ', sample_name, ' (Patient ID: ', patient_id, ')'))
bc2srr2atac.sample <- bc2srr2atac %>% filter(Patient_ID == patient_id)
bc2srr2atac.sample$ID_scDNA <- paste0(bc2srr2atac.sample$Run, '.sorted.markdup')
bc2srr2atac.sample$ID_CHASM <- gsub('\\+', '\\-', bc2srr2atac.sample$barcode)
bc2srr2atac.sample$ID_CHASM <- paste0(sample_name, '-', bc2srr2atac.sample$ID_CHASM)
bc2srr2atac.sample$ID_epiAn <- gsub('\\+', '\\.', bc2srr2atac.sample$barcode)
bc2srr2atac.sample$ID_epiAn <- paste0('cell.', bc2srr2atac.sample$ID_epiAn)
# read scDNA results
cn.ck <- readRDS(paste0(output_dir, 'copykit_scDNA/', sample_name, '_copykit_out.rds'))
print(paste0('Total cells in scDNA: ', ncol(cn.ck)))
ck.mat <- segment_ratios(cn.ck[,colData(cn.ck)$breakpoint_count<brkp_cutoff])
print(paste0('Cells with <', brkp_cutoff, ' breakpoints: ', ncol(ck.mat)))
obj_dp <- cn.ck[, colData(cn.ck)$is_aneuploid==F]
obj_aneu <- cn.ck[, colData(cn.ck)$is_aneuploid==T]
obj_aneu_filt <- obj_aneu[,colData(obj_aneu)$outlier==FALSE]
print(paste0('Aneuploid cells before filtering: ', ncol(obj_aneu)))
print(paste0('Aneuploid cells after filtering: ', ncol(obj_aneu_filt)))
cells_scDNA <- c(colnames(obj_dp), colnames(obj_aneu_filt))
cells_scDNA <- intersect(cells_scDNA, colnames(ck.mat))
bc2srr2atac.sample$in_scDNA <- bc2srr2atac.sample$ID_scDNA %in% cells_scDNA
# bc2srr2atac.sample$aneu_scDNA <- bc2srr2atac.sample$ID_scDNA %in% colnames(obj_aneu_filt)
# read CHASM
cn.comb <- readRDS(paste0(output_dir, 'Wavelet_robustPCA_V7/', sample_name, '/', sample_name, '_output_cn_df.comb.rds'))
bc2srr2atac.sample$inCHASM <- bc2srr2atac.sample$ID_CHASM %in% cn.comb$ID
# read epiAneufinder
cn.epiAn <- read.table(paste0(output_dir, 'epiAneufinder_500kb/', sample_name, '_new/epiAneufinder_results/results_table.tsv'))
bc2srr2atac.sample$inEpiAn <- bc2srr2atac.sample$ID_epiAn %in% colnames(cn.epiAn)
bc2srr2atac.overall <- rbind(bc2srr2atac.overall, bc2srr2atac.sample)
}
View(bc2srr2atac)
rm(list = ls())
library(tidyverse)
options(scipen = 999)
chromosomes <- c(paste0('chr', 1:22), 'chrX', 'chrY')
# ==============================================================================
# Read data
# ==============================================================================
data_dir <- '/Users/emiliac/Dropbox/Rotations/Zhang_lab/scATAC/OtherData/Lin_et_al_breast_epi_GSE272504/'
output_dir <- '/Users/emiliac/Dropbox/Rotations/Zhang_lab/scATAC/output_OtherData/Lin_et_al_breast_epi_GSE272504/'
metadata <- read.csv(paste0(data_dir, 'ArchR_metadata.csv'), row.names = 1)
metadata$celltype <- ifelse(metadata$Harmony_Seurat_clusters == 'C5', 'Basal',
ifelse(metadata$Harmony_Seurat_clusters %in% c('C6', 'C7'), 'LumHR',
ifelse(metadata$Harmony_Seurat_clusters %in% c('C1', 'C2', 'C3', 'C4'), 'LumSec', 'Other')))
bc2srr2atac <- read.csv(paste0(data_dir, 'SraRunTable_bc2srr2ATAC.csv'))
# ==============================================================================
# Get common cells
# ==============================================================================
samples <- unique(metadata$Sample)
samples <- samples[!samples %in% c('GSM8403673_P08', 'GSM8403678_P21')]
bc2srr2atac.overall <- data.frame()
brkp_cutoff <- 15
for(sample_name in samples){
# format IDs
patient_id <- strsplit(sample_name, '_')[[1]][2]
print(paste0('Processing sample: ', sample_name, ' (Patient ID: ', patient_id, ')'))
bc2srr2atac.sample <- bc2srr2atac %>% filter(Patient_ID == patient_id)
bc2srr2atac.sample$ID_scDNA <- paste0(bc2srr2atac.sample$Run, '.sorted.markdup')
bc2srr2atac.sample$ID_CHASM <- gsub('\\+', '\\-', bc2srr2atac.sample$barcode)
bc2srr2atac.sample$ID_CHASM <- paste0(sample_name, '-', bc2srr2atac.sample$ID_CHASM)
bc2srr2atac.sample$ID_epiAn <- gsub('\\+', '\\.', bc2srr2atac.sample$barcode)
bc2srr2atac.sample$ID_epiAn <- paste0('cell.', bc2srr2atac.sample$ID_epiAn)
# read scDNA results
cn.ck <- readRDS(paste0(output_dir, 'copykit_scDNA/', sample_name, '_copykit_out.rds'))
print(paste0('Total cells in scDNA: ', ncol(cn.ck)))
ck.mat <- segment_ratios(cn.ck[,colData(cn.ck)$breakpoint_count<brkp_cutoff])
print(paste0('Cells with <', brkp_cutoff, ' breakpoints: ', ncol(ck.mat)))
obj_dp <- cn.ck[, colData(cn.ck)$is_aneuploid==F]
obj_aneu <- cn.ck[, colData(cn.ck)$is_aneuploid==T]
obj_aneu_filt <- obj_aneu[,colData(obj_aneu)$outlier==FALSE]
print(paste0('Aneuploid cells before filtering: ', ncol(obj_aneu)))
print(paste0('Aneuploid cells after filtering: ', ncol(obj_aneu_filt)))
cells_scDNA <- c(colnames(obj_dp), colnames(obj_aneu_filt))
cells_scDNA <- intersect(cells_scDNA, colnames(ck.mat))
bc2srr2atac.sample$in_scDNA <- bc2srr2atac.sample$ID_scDNA %in% cells_scDNA
# bc2srr2atac.sample$aneu_scDNA <- bc2srr2atac.sample$ID_scDNA %in% colnames(obj_aneu_filt)
# read CHASM
cn.comb <- readRDS(paste0(output_dir, 'Wavelet_robustPCA_V7/', sample_name, '/', sample_name, '_output_cn_df.comb.rds'))
bc2srr2atac.sample$inCHASM <- bc2srr2atac.sample$ID_CHASM %in% cn.comb$ID
# read epiAneufinder
cn.epiAn <- read.table(paste0(output_dir, 'epiAneufinder_500kb/', sample_name, '_new/epiAneufinder_results/results_table.tsv'))
bc2srr2atac.sample$inEpiAn <- bc2srr2atac.sample$ID_epiAn %in% colnames(cn.epiAn)
bc2srr2atac.overall <- rbind(bc2srr2atac.overall, bc2srr2atac.sample)
}
# ==============================================================================
# Add cell type information
# ==============================================================================
bc2srr2atac.overall$Patient_ID <- str_split_fixed(bc2srr2atac.overall$ID_CHASM, '-', 2)[,1]
bc2srr2atac.overall$cell_id <- paste0(bc2srr2atac.overall$Patient_ID, '#', bc2srr2atac.overall$barcode)
bc2srr2atac.overall <- merge(bc2srr2atac.overall, metadata[, c('cell_id', 'celltype')], all.x = T)
write.csv(bc2srr2atac.overall, paste0(data_dir, 'SraRunTable_bc2srr2ATAC_withCellType_050526.csv'), row.names = F)
rm(list = ls())
library(tidyverse)
library(ggplot2)
library(ggpubr)
# sample_name <- 'QY_2213'
# ==============================================================================
# Read data
# ==============================================================================
data_dir <- '/Users/emiliac/Dropbox/Rotations/Zhang_lab/scATAC/OtherData/C57BL6J_liver_hippocampus/'
ref_dir <- '/Users/emiliac/Dropbox/Rotations/Zhang_lab/scATAC/Files/'
out_dir <- '/Users/emiliac/Dropbox/Rotations/Zhang_lab/scATAC/output_OtherData/C57BL6J_liver_hippocampus/'
fig_dir <- '/Users/emiliac/Dropbox/Rotations/Zhang_lab/scATAC/Figures/V1/Figure3/'
samples <- c('MM_1202', 'MM_1203', 'MM_1220', 'MM_1221', 'QY_2215', 'QY_2217', 'QY_2219', 'QY_2213',
'QY_2241', 'QY_2243', 'QY_2245', 'QY_2247', 'QY_2320', 'QY_2322', 'QY_2324', 'QY_2326')
# QY_2213
etrp <- read.csv(paste0(data_dir, 'liver_data_hepatocyte_only_cellular_dispersion_SAVER.csv'))
samples <- c('QY_2213', 'MM_1202', 'MM_1203', 'MM_1220', 'MM_1221', 'QY_2215', 'QY_2217', 'QY_2219',
'QY_2241', 'QY_2243', 'QY_2245', 'QY_2247', 'QY_2320', 'QY_2322', 'QY_2324', 'QY_2326')
etrp <- read.csv(paste0(data_dir, 'liver_data_hepatocyte_only_cellular_dispersion_SAVER.csv'))
cn_bin.eval.alter.all <- data.frame()
for(sample_name in samples){
print(sample_name)
output.all <- readRDS(paste0(out_dir, sample_name, '_output.rds'))
cn_bin <- output.all[["cn_bin"]]
cn_state.nb <- readRDS(paste0(out_dir, sample_name, '_cn_state_nb.rds'))
# ==============================================================================
# Combine results
# ==============================================================================
cn_df.comb <- merge(cn_bin, cn_state.nb, by.x = c('ID', 'chr'), by.y = c('ID', 'chrom'))
cn_df.comb$CN_state.final <- ifelse(!is.na(cn_df.comb$p_value.adj) & cn_df.comb$p_value.adj < 0.05 & cn_df.comb$CN_state_adj != 2 & is.na(cn_df.comb$CN_state.binom),
2,
cn_df.comb$CN_state_adj)
# ==============================================================================
# Wrangle data
# ==============================================================================
# calculate percentage genome altered
cn_bin.eval <- cn_df.comb %>% dplyr::select(ID, segment_output_ID, CN_state.final) %>% distinct()
cn_bin.eval[, c('chr', 'start.segment', 'end.segment')] <- str_split_fixed(cn_bin.eval$segment_output_ID, '_', 3)
cn_bin.eval$start.segment <- as.numeric(cn_bin.eval$start.segment)
cn_bin.eval$end.segment <- as.numeric(cn_bin.eval$end.segment)
cn_bin.eval.alter <- cn_bin.eval %>%
filter(CN_state.final != 2) %>%
dplyr::group_by(ID) %>%
dplyr::summarise(length.alter = sum(end.segment - start.segment + 1))
bins <- unique(cn_bin$variable)
bins_df <- as.data.frame(bins)
bins_df[, c("chr", 'start', 'end', 'arm')] <- str_split_fixed(bins_df$bins, '_', 4)
bins_df$start <- as.numeric(bins_df$start)
bins_df$end <- as.numeric(bins_df$end)
bins_df$length <- bins_df$end - bins_df$start + 1
genome.size <- sum(bins_df$length)
cn_bin.eval.alter$pct.alter <- cn_bin.eval.alter$length.alter / genome.size * 100
cn_bin.eval.alter <- complete(cn_bin.eval.alter, ID = unique(cn_bin.eval$ID), fill = list(length.alter = 0, pct.alter = 0))
cn_bin.eval.alter$sample_name <- sample_name
cn_bin.eval.alter.all <- rbind(cn_bin.eval.alter.all, cn_bin.eval.alter)
}
# merge cn alteration and mitotic age
comp_df <- merge(cn_bin.eval.alter.all, etrp, by.x = 'ID', by.y = 'Cell_barcode')
ggplot(comp_df, aes(x = pct.alter, y = Cell_level_deviation)) +
geom_point(size = 0.5) +
ylim(c(0, 1000)) +
facet_wrap(~ Age+sample_name, ncol = 4) +
stat_cor(method = 'spearman') +
theme_bw() +
xlab('Percentage of Genome Altered (%)')
metadat <- readRDS(paste0(data_dir, "liver_metadata.RDS"))
metadat$ID <- rownames(metadat)
df <- merge(cn_bin.eval.alter.all, metadat, by.x = c('ID', 'sample_name'), by.y = (c('ID', 'group')))
saveRDS(df, paste0(out_dir, 'Summary/cn_bin_eval_alter_all_050626.rds'))
cn_bin_summary <- df %>%
group_by(sample_name, age, annotation) %>%
summarise(mean_pct_alter = mean(pct.alter),
median_pct_alter = median(pct.alter),
sd_pct_alter = sd(pct.alter),
n_cells = n())
cn_bin_summary$age <- factor(cn_bin_summary$age, levels = c('young', 'old'))
cn.young <- cn_bin_summary %>% filter(age == 'young')
cn.young <- cn.young %>%
group_by(annotation) %>%
summarise(mean_pct_alter = mean(mean_pct_alter)) %>%
arrange(mean_pct_alter)
cn_bin_summary$annotation <- factor(cn_bin_summary$annotation, levels = c('Hepatocyte', 'Neutrophil', 'B cell', 'T cell',
'Endothelial', 'Fibroblast', 'Myeloid lineage cells', 'Cholangiocyte'))
ggplot(cn_bin_summary, aes(x = age, y = mean_pct_alter, fill = age)) +
geom_jitter(aes(size = n_cells), width = 0.2, shape = 21, color = 'black') +
geom_boxplot(outlier.shape = NA, width = 0.45, alpha = 0.6, linewidth = 0.3) +
stat_compare_means(aes(group = age),
comparisons = list(c("young", "old")),
label = "p.format", size = 2) +
scale_fill_manual(values = c('young' = '#9CC6DB', 'old' = '#CF4B00')) +
facet_wrap(~ annotation, ncol = 4, scale = 'free_x') +
scale_size_continuous(range = c(1, 3)) +
ylim(0, 10) +
xlab('Cell Type') +
ylab('Mean Percentage of Genome Altered (%)') +
theme_bw(base_size = 7) +
theme(panel.grid.minor = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1))
View(df)
length(unique(df$sample_name))
